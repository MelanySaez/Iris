# Copy to `.env` in the repository root and adjust: cp .env.example .env
# `.env` is git-ignored. docker/podman compose read it automatically.
# Load it into your shell before running the backend or tests:
#   set -a && source .env && set +a

# --- PostgreSQL container (compose.yaml) ---------------------------------------
# Host port for the database. 5433 avoids clashing with a system PostgreSQL.
DB_PORT=5433
POSTGRES_USER=iris
POSTGRES_PASSWORD=iris
POSTGRES_DB=iris

# --- Backend (apps/server) ----------------------------------
# Selection records storage. Leave empty to run without a database
# (jobs keep working; /api/selections answers 503).
DATABASE_URL=postgresql+psycopg://iris:iris@127.0.0.1:5433/iris

# Optional: local SPHEREx Level-2 FITS sample. Defaults to
# apps/server/data/level2_2025W18_1B_0001_1D2_spx_l2b-v20-2025
# SPHEREX_SPECTRAL_FITS=/absolute/path/to/level2.fits

# --- Tests ---------------------------------------------------------------------
# Disposable database for apps/server/tests/test_selections.py
# (create it once: docker|podman compose exec db createdb -U iris iris_test).
TEST_DATABASE_URL=postgresql+psycopg://iris:iris@127.0.0.1:543
