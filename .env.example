# Docker compose settings. Copy to `.env` in the repository root:
#   cp .env.example .env
# `.env` is git-ignored. `docker compose` / `podman compose` read it
# automatically when run from the repository root.
# Local settings for each service live in apps/server/.env.example and
# apps/web/.env.example.

# --- PostgreSQL container (compose.yaml) ---------------------------------------
# Host port for the database. 5433 avoids clashing with a system PostgreSQL.
DB_PORT=5433
POSTGRES_USER=iris
POSTGRES_PASSWORD=iris
POSTGRES_DB=iris

# --- Server container ----------------------------------------------------------
# Comma-separated frontend origins allowed by the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Contextual assistant (chat bubble, bottom right). Works with any model served
# through an OpenAI-compatible Chat Completions API (OpenAI, OpenRouter, Groq,
# Together, Ollama, vLLM, LM Studio...) and needs a model that supports tool
# calling. Leave the key or the model empty to keep the assistant disabled
# (its endpoints answer 503 and the rest of the app keeps working).
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
# Base URL of the provider; leave empty for OpenAI itself. Examples:
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1   (Ollama; any non-empty key works)
ASSISTANT_BASE_URL=
# Optional tuning (defaults shown):
# ASSISTANT_MAX_TOKENS=            (unset: provider default)
# ASSISTANT_MAX_TOOL_ROUNDS=6
# ASSISTANT_RATE_LIMIT_PER_MINUTE=20
# ASSISTANT_CACHE_TTL_SECONDS=3600
# ASSISTANT_CACHE_MAX_ENTRIES=256
# ASSISTANT_LOG_PATH=data/logs/assistant.jsonl

# --- Web container -------------------------------------------------------------
NODE_ENV=production
