# Local backend settings. Copy to `apps/server/.env`: cp .env.example .env
# `.env` is git-ignored. Load it into the shell before starting the server,
# running migrations or running tests (from apps/server):
#   set -a && source .env && set +a

# Selection records storage (PostgreSQL via SQLAlchemy + psycopg 3).
# User, password, port and database must match the root `.env` (compose.yaml).
# Leave empty to run without a database: jobs keep working and
# /api/selections answers 503.
DATABASE_URL=postgresql+psycopg://iris:iris@127.0.0.1:5433/iris

# Tests use this same database but never its data: they work inside a
# throwaway schema (test_<random>) that is dropped when the run ends.

# Optional: local SPHEREx Level-2 FITS sample. Defaults to
# apps/server/data/level2_2025W18_1B_0001_1D2_spx_l2b-v20-2025-240.fits
# SPHEREX_SPECTRAL_FITS=/absolute/path/to/level2.fits
