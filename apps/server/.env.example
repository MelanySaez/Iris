# Copy to `.env` in the repository root: cp .env.example .env
# `.env` is git-ignored. `docker compose` / `podman compose` read it
# automatically when run from the repository root.

# --- PostgreSQL container (compose.yaml) ---------------------------------------
# Host port for the database. 5433 avoids clashing with a system PostgreSQL.
DB_PORT=5433
POSTGRES_USER=iris
POSTGRES_PASSWORD=iris
POSTGRES_DB=iris

# Backend and frontend variables live in apps/server/.env.example and
# apps/web/.env.example. Keep their DATABASE_URL in sync with the values above.
